---
import { getCollection, type CollectionEntry } from 'astro:content';
import ContentPage from '@moliver28/theme/layouts/ContentPage.astro';
import DiscoveryHead from '../../components/DiscoveryHead.astro';

export async function getStaticPaths() {
  const items = await getCollection('customEntities');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'customEntities'>;
}
const { entry } = Astro.props;
const data = entry.data as Record<string, unknown>;
---

<ContentPage
  title={String(data.name ?? entry.id)}
  description={typeof data.summary === 'string' ? data.summary : undefined}
  kicker={String(data.kind ?? 'custom')}
  block={data}
  siteName="Investigations"
  skip={['name', 'kind']}
>
  <Fragment slot="head-extra">
    <DiscoveryHead
      type="website"
      title={String(data.name ?? entry.id)}
      description={typeof data.summary === 'string' ? data.summary : undefined}
      path={`custom-entities/${entry.id}/`}
    />
  </Fragment>
</ContentPage>
