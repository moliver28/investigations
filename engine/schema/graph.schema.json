{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hermes.investigations/schema/graph.schema.json",
  "title": "Investigation Power Graph",
  "description": "Nodes (actors/orgs) + edges (relationships). Flexible (additionalProperties allowed) but strict on the load-bearing fields so drift fails loudly at validation, not silently at render.",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": { "type": "array", "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "label", "type", "domain"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Lowercase, hyphen-separated slug (e.g. ryan-mello, county-council)."
        },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["person", "organization"] },
        "domain": {
          "enum": ["government", "economic", "institutional", "political", "legal", "media"]
        },
        "desc": { "type": ["string", "null"] },
        "facts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "relationship"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "relationship": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Lowercase, underscore-separated verb (e.g. member, donated, federal_appropriations)."
        },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
