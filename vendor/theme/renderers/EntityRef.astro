---
/**
 * Entity-reference fields (keys like *_ref, *_id, *_entity): render as a link
 * to the conventional entity profile route (/entities/<id>/). The value is
 * escaped by Astro; the href is constrained to the known route shape.
 */
import type { FieldView } from '../blocks/fields';

interface Props {
  field: FieldView;
}
const { field } = Astro.props;
const id = typeof field.value === 'string' ? field.value.trim() : '';
const valid = /^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(id);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = valid ? `${base}entities/${id}/` : '';
---

{
  valid ? (
    <a class="sf-entity-ref" href={href} data-entity-id={id}>
      {id.replace(/[-_]+/g, ' ')}
    </a>
  ) : (
    <code>{String(field.value)}</code>
  )
}
