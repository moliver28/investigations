---
/**
 * Opening-hours fields (#88): day/range dicts render as a two-column
 * definition list (day → hours) instead of the JSON dump the generic list
 * fallback gave them. `display: contents` on the wrapping divs keeps the
 * outer grid two-column while staying valid dl > div > dt+dd markup.
 *
 * No scoped <style>: every theme component that statically joins the block
 * chain contributes its CSS to every page that renders a block, so new
 * field/block styling rides inline token-driven attributes — a site whose
 * data never triggers this type builds byte-identically (#88 contract).
 */
import type { FieldView } from '../blocks/fields';

interface Props {
  field: FieldView;
}
const { field } = Astro.props;
const rows = Array.isArray(field.value) ? field.value.filter((r): r is Record<string, unknown> => typeof r === 'object' && r !== null && !Array.isArray(r)) : [];

/** First string value among preferred keys, else ''. */
const pick = (row: Record<string, unknown>, keys: readonly string[]): string => {
  for (const key of keys) {
    const value = row[key];
    if (typeof value === 'string' && value.trim() !== '') return value.trim();
    if (typeof value === 'number') return String(value);
  }
  return '';
};
const cell = (value: unknown): string => (typeof value === 'object' && value !== null ? JSON.stringify(value) : String(value ?? ''));
---

{
  rows.length > 0 && (
    <dl class="sf-hours" style="display:grid;grid-template-columns:auto auto;gap:0.15rem var(--sf-space-3);margin:0;width:fit-content">
      {rows.map((row) => {
        const day = pick(row, ['day', 'days', 'weekday', 'date']);
        const open = pick(row, ['open', 'opens', 'opening']);
        const close = pick(row, ['close', 'closes', 'closing']);
        const range = open !== '' || close !== '' ? [open, close].filter((part) => part !== '').join(' – ') : Object.entries(row).filter(([k]) => !['day', 'days', 'weekday', 'date'].includes(k)).map(([, v]) => cell(v)).join(' – ');
        return (
          <div style="display:contents">
            <dt style="font-weight:600">{day !== '' ? day : '—'}</dt>
            <dd style="margin:0;color:var(--sf-color-muted)">{range !== '' ? range : '—'}</dd>
          </div>
        );
      })}
    </dl>
  )
}
