---
/**
 * Image fields: either a URL string (via an image-shaped key) or an object
 * { url|src, alt?, caption? }. Alt falls back to the caption, then the field
 * label — decorative unknowns never break the page.
 */
import type { FieldView } from '../blocks/fields';

interface Props {
  field: FieldView;
}
const { field } = Astro.props;

let src = '';
let alt = field.label;
let caption: string | undefined;
if (typeof field.value === 'string') {
  src = field.value;
} else if (typeof field.value === 'object' && field.value !== null) {
  const v = field.value as Record<string, unknown>;
  const rawSrc = v.url ?? v.src ?? v.image;
  if (typeof rawSrc === 'string') src = rawSrc;
  if (typeof v.alt === 'string') alt = v.alt;
  if (typeof v.caption === 'string') caption = v.caption;
}

// http(s) external or site-rooted internal paths only; protocol-relative
// //host/x.png is rejected (same rule as LinkRenderer/EvidenceCite).
const safeSrc = /^https?:\/\//i.test(src) || (src.startsWith('/') && !src.startsWith('//')) ? src : '';
---

{
  safeSrc !== '' && (
    <figure class="sf-image">
      <img src={safeSrc} alt={alt} loading="lazy" decoding="async" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  /* Figure tokens (ADR #84): the image renderer is the family's real
     consumer. Every declaration here is either token-driven (frame,
     caption ink, caption size via the type ramp) or the declared
     layout-integrity pair (max-width/height — overflow containment, a
     pixel no-op for images inside the text measure). UA margins and flow
     are stock; no restyle beyond what the token table declares. */
  .sf-image img {
    max-width: 100%;
    height: auto;
    border: var(--sf-figure-frame);
  }

  .sf-image figcaption {
    font-size: var(--sf-type-scale-sm);
    color: var(--sf-figure-caption);
  }
</style>
