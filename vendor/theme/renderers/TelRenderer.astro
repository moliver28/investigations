---
/**
 * Phone fields (#88): `tel:` link so mobile readers tap to dial. The
 * href keeps only the dialable characters; the visible text is the value
 * verbatim (formatting is content, not data). A value that slipped past
 * the inference guard renders as plain text — never a broken link.
 *
 * No scoped <style>: every theme component that statically joins the block
 * chain contributes its CSS to every page that renders a block, so new
 * field/block styling rides inline token-driven attributes — a site whose
 * data never triggers this type builds byte-identically (#88 contract).
 */
import type { FieldView } from '../blocks/fields';

interface Props {
  field: FieldView;
}
const { field } = Astro.props;
const raw = typeof field.value === 'string' ? field.value.trim() : '';
const dialable = raw.replace(/[^\d+]/g, '');
---

{
  raw !== '' && dialable.replace(/\D/g, '').length >= 5 ? (
    <a href={`tel:${dialable}`}>{raw}</a>
  ) : (
    <span>{raw}</span>
  )
}
