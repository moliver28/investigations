---
/**
 * FAQ block (P14 A1): Q&A items as native exclusive accordions — zero JS.
 * Source kit: Pico Accordion (https://picocss.com/docs/accordion — "pure
 * HTML, without JavaScript") + APG Accordion/Disclosure
 * (https://www.w3.org/WAI/ARIA/apg/patterns/accordion/ and
 * https://www.w3.org/WAI/ARIA/apg/patterns/disclosure/): <summary> and
 * the details open state supply the button semantics, so no ARIA is
 * needed. Semantic skeleton: section > details[name] > summary + div.
 * Exclusive-open rides the native `name` attribute (Chrome 120+/Firefox
 * 130+/Safari 17.2+; older browsers degrade to independent disclosures).
 * The name is content-derived — `sf-faq-` + djb2 of the questions,
 * base36 — so two faq blocks on one page never share an exclusivity group.
 *
 * Props:
 *   items  array of { q, a } (entries missing either are skipped; no
 *          valid entries renders nothing — hero precedent)
 *
 * No scoped <style>: the block chain is statically imported on every page
 * that renders any block, so a <style> here would join the shared CSS of
 * sites that never declare this kind — inline token-driven attributes
 * keep unused-feature builds byte-identical (#128 contract).
 */
interface Props {
  block: Record<string, unknown>;
  skip?: readonly string[];
}
const { block } = Astro.props;
const entries = Array.isArray(block.items) ? block.items : [];
const items = entries
  .filter((entry): entry is Record<string, unknown> => typeof entry === 'object' && entry !== null && !Array.isArray(entry))
  .map((entry) => ({
    q: typeof entry.q === 'string' ? entry.q.trim() : '',
    a: typeof entry.a === 'string' ? entry.a.trim() : '',
  }))
  .filter((item) => item.q !== '' && item.a !== '');
const hash = (seed: number, text: string): number => {
  for (const ch of text) seed = (seed * 33 + ch.charCodeAt(0)) >>> 0;
  return seed;
};
const group = `sf-faq-${items.reduce((h, item) => hash(h, item.q), 5381).toString(36)}`;
---

{
  items.length > 0 && (
    <section class="sf-faq" style="margin:var(--sf-space-4) 0">
      {items.map((item) => (
        <details class="sf-faq-item" name={group} style="border-block-end:var(--sf-line)">
          <summary style="padding:var(--sf-space-2) 0;font-family:var(--sf-font-display);font-size:var(--sf-type-scale-md);cursor:pointer">{item.q}</summary>
          <div style="padding:0 0 var(--sf-space-2);color:var(--sf-color-muted);font-size:var(--sf-type-scale-sm)">{item.a}</div>
        </details>
      ))}
    </section>
  )
}
