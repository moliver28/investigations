---
/**
 * Quote block (#128): a pull-quote / testimony as figure > blockquote >
 * figcaption — attribution stays machine-linked to the quotation, and the
 * accent rule marks the excerpt without fake quotation-mark typography.
 * `variant: card` (P14 B1b, DaisyUI Card anatomy:
 * https://daisyui.com/components/card/): the figure as a bordered surface
 * box lifted by `--sf-shadow-1` instead of the accent rule.
 * `variant: band` (P14 B1b, shadcn Card anatomy:
 * https://ui.shadcn.com/docs/components/card): a centered full-width band
 * between two `--sf-line` rules on a token-mixed accent tint.
 *
 * Props:
 *   text         the quotation (required; without it nothing renders)
 *   attribution  who said/wrote it (optional)
 *   cite_url     http(s) source link wrapped around the attribution
 *                (optional)
 *
 * No scoped <style>: the block chain is statically imported on every page
 * that renders any block, so a <style> here would join the shared CSS of
 * sites that never declare this kind — inline token-driven attributes keep
 * unused-feature builds byte-identical (#128 contract).
 */
export const supportedVariants = ['card', 'band'] as const;

interface Props {
  block: Record<string, unknown>;
  skip?: readonly string[];
}
const { block } = Astro.props;
const textValue = (key: string): string => (typeof block[key] === 'string' ? (block[key] as string).trim() : '');
const quote = textValue('text');
const attribution = textValue('attribution');
const citeUrlRaw = textValue('cite_url');
const citeUrl = /^https?:\/\//i.test(citeUrlRaw) ? citeUrlRaw : '';
const variant = (supportedVariants as readonly string[]).includes(textValue('variant')) ? textValue('variant') : '';
const figureStyle = variant === 'card' ? 'margin:var(--sf-space-4) 0;border:var(--sf-line);border-radius:var(--sf-radius);background:var(--sf-color-surface);box-shadow:var(--sf-shadow-1);padding:var(--sf-space-3)' : variant === 'band' ? 'margin:var(--sf-space-4) 0;border-block:var(--sf-line);padding:var(--sf-space-4) var(--sf-space-3);text-align:center;background:color-mix(in srgb, var(--sf-color-accent) 8%, var(--sf-color-bg))' : 'margin:var(--sf-space-4) 0;border-inline-start:3px solid var(--sf-color-accent);padding-inline-start:var(--sf-space-3)';
---

{
  quote !== '' && (
    <figure class="sf-quote" data-block-variant={variant === '' ? undefined : variant} style={figureStyle}>
      <blockquote style="margin:0;font-family:var(--sf-font-display);font-size:var(--sf-type-scale-lg);font-style:italic">
        <p style="margin:0">{quote}</p>
      </blockquote>
      {
        attribution !== '' && (
          <figcaption class="sf-quote-attribution" style="margin-top:var(--sf-space-2);color:var(--sf-color-muted);font-size:var(--sf-type-scale-sm)">
            {citeUrl !== '' ? (
              <a href={citeUrl} style="color:inherit">— {attribution}</a>
            ) : (
              <>— {attribution}</>
            )}
          </figcaption>
        )
      }
    </figure>
  )
}
