---
/**
 * Block dispatcher: resolves a block's kind through the registry and renders
 * it. Unknown kinds fall back to the generic fields block (never an error,
 * never a blank) — new block types must never require theme changes.
 */
import { normalizeBlockKind } from './registry';
import { resolveBlockComponent } from './components';

interface Props {
  block: Record<string, unknown>;
  skip?: readonly string[];
  /**
   * Explicit registry kind (P6.7 composed pages declare the kind OUT of
   * band, as the `block:` id in site.config.yaml, so the data itself stays
   * clean). Absent on every data-driven render — the kind is derived from
   * the block data exactly as before, byte-identical.
   */
  kind?: string;
}
const { block, skip, kind: explicitKind } = Astro.props;
const kind = normalizeBlockKind(explicitKind ?? block.kind ?? block.type);
const BlockComponent = resolveBlockComponent(kind);
---

<div class="sf-block-wrap" data-block-kind={kind}>
  <BlockComponent block={block} skip={skip} />
</div>
