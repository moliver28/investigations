{
  "name": "@moliver28/theme",
  "version": "0.6.0",
  "description": "Auto-adapting Astro theme: design tokens, generic field renderers, block registry, entity graph island. Unknown data fields render with zero component code changes.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moliver28/sitefactory.git",
    "directory": "packages/theme"
  },
  "files": [
    "config",
    "index.ts",
    "blocks",
    "graph",
    "layouts",
    "renderers",
    "tokens"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": "./index.ts",
    "./tokens.css": "./tokens/presets/journalism-default/tokens.css",
    "./tokens/active.css": "./tokens/presets/journalism-default/tokens.css",
    "./config/preset": "./config/preset.js",
    "./config/match": "./config/match.js",
    "./graph/compiler": "./graph/compiler.ts",
    "./blocks/fields": "./blocks/fields.ts",
    "./blocks/registry": "./blocks/registry.ts",
    "./layouts/*": "./layouts/*",
    "./blocks/*": "./blocks/*",
    "./renderers/*": "./renderers/*",
    "./graph/*": "./graph/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "astro check"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "sigma": "^4.0.4",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.4",
    "typescript": "^6.0.3"
  }
}
